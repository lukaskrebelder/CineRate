# Kopieren zu ".env" und mit echten Werten füllen
# .env selbst NIE ins Git-Repo committen (siehe .gitignore)

TMDB_API_KEY=dein_tmdb_key_hier
PORT=3000

# PostgreSQL-Verbindung. Auf Heroku wird DATABASE_URL automatisch gesetzt,
# sobald das Heroku-Postgres-Add-on aktiv ist. Für lokale Entwicklung selbst eintragen:
DATABASE_URL=postgres://user:passwort@localhost:5432/cinerate

# Adresse des Frontends, für CORS. Lokal kann das leer bleiben (dann alles erlaubt).
FRONTEND_URL=
